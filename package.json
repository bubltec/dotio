{
  "name": "dotio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "lint": "oxlint -c .oxlintrc.json infra site",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "cdk": "pnpm --filter @dotio/infra run cdk",
    "dev": "python3 -m http.server 5180 --directory site"
  },
  "devDependencies": {
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
